<Window x:Class="TP4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TP4"
        mc:Ignorable="d"
        Title="TP4" Height="450" Width="800">
    <Grid >

        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="8*"/>
        </Grid.RowDefinitions>
        <Menu x:Name="mnuPrincip" Grid.Row="0" Width="auto" IsMainMenu="True"
                  VerticalAlignment="Top">

            <MenuItem Name="mnuGestion" Header="Gestion">
                <MenuItem Name="mnuCours" Header="Cours" Command="{Binding CourSelection}"/>
                <MenuItem Name="mnuMenbres" Header="Membres" Command="{Binding MembreSelection}"/>
            </MenuItem>
        </Menu>

        <ComboBox Name="cmbCours" ItemsSource="{Binding TypeCours}" DisplayMemberPath="Nom" SelectedItem="{Binding Type}"  Margin="65,24,599,0" Grid.RowSpan="2"/>


        <!--SelectedItem="{Binding Cours}"-->
        <DataGrid Name="dgCours"  ItemsSource="{Binding ListCours}"  Grid.Row="2"  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="1*" IsReadOnly="True"  />
                <DataGridTextColumn Header="Type du Cours" Binding="{Binding TypeCours.Nom}" Width="1*" IsReadOnly="True"  />
                <DataGridTextColumn Header="Debut" Binding="{Binding DateDebut}" Width="1*" IsReadOnly="True"  />
                <DataGridTextColumn Header="Fin" Binding="{Binding DateFin}" Width="1*" IsReadOnly="True"  />
                <DataGridTextColumn Header="Place disponible" Binding="{Binding PlaceDisponible}" Width="1*" IsReadOnly="True"  />

            </DataGrid.Columns>
        </DataGrid>



    </Grid>
</Window>
