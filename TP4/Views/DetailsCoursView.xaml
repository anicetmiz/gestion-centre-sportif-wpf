<Window x:Class="TP4.Views.DetailsCoursView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TP4.Views"
        mc:Ignorable="d"
        Title="DetailsCoursView" Height="450" Width="800">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="true">
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=(Validation.Errors).CurrentItem.ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DatePicker">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="true">
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=(Validation.Errors).CurrentItem.ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="true">
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=(Validation.Errors).CurrentItem.ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="153*"/>
            <RowDefinition Height="64*"/>
        </Grid.RowDefinitions>


        <Label Name="lbNom" Grid.Row="0" Grid.Column="0" Content="Nom:"  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,0,0" Height="26" Width="39"/>
        <!--evite le losFoccus UpdateSourceTrigger = PropertyChanged-->
        <TextBox Name="tbValeurNom" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Text="{Binding Nom,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" Width="257"  Height="29" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0"></TextBox>


        <Label Name="lbCout" Content="Cout" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"  Margin="0,50,0,0" Height="26" Width="35"/>
        <TextBox Name="tbValeurCout" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top"  Margin="0,50,0,0" TextWrapping="Wrap" Text="{Binding Cout,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" Width="257"  Height="29"></TextBox>


        <Label Name="lbDateDebut" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Top"  Margin="0,100,0,0" Content="Date de Début" Height="26" Width="87" />
        <DatePicker Name="dpDebut" DisplayDateStart="2025-01-01" SelectedDateFormat="Short" SelectedDate="{Binding DateDebut,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top"  Margin="0,100,0,0"  Width="257"  Height="29"></DatePicker>


        <Label Name="lbDateFin"  Content="Date de Fin" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Top"  Margin="0,155,0,0" Height="26" Width="70"></Label>
        <DatePicker Name="dpFin" DisplayDateStart="2025-01-01" SelectedDateFormat="Short" SelectedDate="{Binding DateFin,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top"  Margin="0,155,0,0"  Width="257"  Height="29" ></DatePicker>

        <Label Name="lbPlacesDispo"  Content="Places dispo" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Top"  Margin="0,205,0,0" Height="26" Width="75"></Label>
        <TextBox Name="tbPlaceDispo"  Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top"  Margin="0,205,0,0" TextWrapping="Wrap" Text="{Binding NbPlace,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" Width="257"  Height="29"></TextBox>



        <Label Name="lbType"  Content="Type" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Top"  Margin="0,255,0,0" Height="26" Width="34"></Label>
        <ComboBox Name="cmbType" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top"  Margin="0,255,0,0" Width="257"  Height="29" ItemsSource="{Binding TypeCours,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" DisplayMemberPath="Nom" SelectedItem="{Binding Type,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" />

        <Button x:Name="btnSauvegader"  Grid.Row="1" Grid.Column="1" Command="{Binding Sauvegarder}" Content="Sauvegarder" Height="25" Width="80" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,7,0,0"></Button>
        <Button x:Name="btnAnnuler"  Grid.Row="1" Grid.Column="1" Command="{Binding     Annuler}" Content="Annuler" Height="25" Width="80"  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="220,7,0,0"></Button>


    </Grid>
</Window>
